{
  "name": "devfest-toulouse-backend",
  "version": "0.1.0",
  "description": "DevFest Toulouse 2026 — REST API backend",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "pnpm --dir ../.. db:migrate",
    "db:generate": "pnpm --dir ../.. db:generate",
    "db:push": "pnpm --dir ../.. db:push",
    "db:studio": "pnpm --dir ../.. db:studio",
    "test": "echo \"No tests configured yet\" && exit 0"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "dotenv": "^17.3.1",
    "fastify": "^5.8.4",
    "pg": "^8.20.0",
    "prisma": "^7.6.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}
