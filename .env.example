# DevFest Toulouse 2026 — Environment Variables
# Copy this file to .env and fill in the values.
# These values are interpolated by Docker Compose into service environment blocks.
# The applications read from process.env, never from .env directly.

# --- Application ---
BASE_URL=http://localhost:3000
FRONTEND_PORT=3000
BACKEND_PORT=4000

# --- Database (PostgreSQL) ---
POSTGRES_USER=devfest
POSTGRES_PASSWORD=devfest
POSTGRES_DB=devfest

# --- Security ---
SESSION_SECRET=change-me-session-secret-minimum-32-characters-long
# MAGIC_LINK_SECRET=change-me-magic-link-secret-minimum-32-chars (Lot 2)

# --- OAuth (Lot 2) ---
# OAUTH_GOOGLE_CLIENT_ID=your-google-client-id
# OAUTH_GOOGLE_CLIENT_SECRET=your-google-client-secret
# OAUTH_GITHUB_CLIENT_ID=your-github-client-id
# OAUTH_GITHUB_CLIENT_SECRET=your-github-client-secret
# ADMIN_EMAILS=admin@devfesttoulouse.fr

# --- SMTP ---
SMTP_FROM=contact@devfesttoulouse.fr
# SMTP_HOST and SMTP_PORT are set directly in docker-compose.yml (mailhog in dev)

# --- Third-party APIs ---
# BILLETWEB_API_KEY=your-billetweb-api-key
