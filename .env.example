# DevFest Toulouse 2026 — Environment Variables
# Copy this file to .env and fill in the values.
# These values are interpolated by Docker Compose into service environment blocks.
# The applications read from process.env, never from .env directly.
#
# Documentation complète : docs/variables-environnement.md

# --- Environment ---
NODE_ENV=development
ENV_NAME=local
BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://backend:4000

# --- Ports ---
FRONTEND_PORT=3000
BACKEND_PORT=4000
DB_PORT=5432

# --- Database (PostgreSQL) ---
POSTGRES_USER=devfest
POSTGRES_PASSWORD=devfest
POSTGRES_DB=devfest

# --- Logging / Debug ---
# Backend log level (fatal | error | warn | info | debug | trace). Default: info
LOG_LEVEL=info
# Set to "true" to expose OpenAPI docs at /api/docs in production
SWAGGER_PUBLIC=false

# --- Security ---
# Min 32 random characters
SESSION_SECRET=change-me-session-secret-minimum-32-characters-long
# Distinct from SESSION_SECRET, used by magic links (Lot 2)
MAGIC_LINK_SECRET=change-me-magic-link-secret-minimum-32-chars
# Shared between backend and frontend to invalidate the Next.js cache
# via POST /api/revalidate. If absent, on-demand revalidation is disabled.
REVALIDATE_SECRET=change-me-revalidate-secret-minimum-32-characters
# HMAC secret to sign per-message brochure download links sent by email.
# If absent, confirmation emails fall back to the raw URL (no per-message tracking).
BROCHURE_TOKEN_SECRET=change-me-brochure-token-secret-min-32-chars
# Lets the scheduled task call the trash purge without a session, via the
# X-Purge-Secret header. Without it the endpoint only accepts an ADMIN session:
# the automatic purge stops running, nothing breaks, nothing opens up.
TRASH_PURGE_SECRET=change-me-trash-purge-secret-minimum-32-chars
# Days a deleted item stays recoverable in the trash. Defaults to 30; an invalid
# or < 1 value falls back to 30 so a typo cannot empty the trash.
TRASH_RETENTION_DAYS=30

# --- OAuth (Google + GitHub) — Lot 2 ---
OAUTH_GOOGLE_CLIENT_ID=your-google-client-id
OAUTH_GOOGLE_CLIENT_SECRET=your-google-client-secret
OAUTH_GITHUB_CLIENT_ID=your-github-client-id
OAUTH_GITHUB_CLIENT_SECRET=your-github-client-secret

# --- Admin access ---
# Comma-separated list of emails granted ADMIN role on bootstrap (seed)
ADMIN_EMAILS=admin@devfesttoulouse.fr,editor@devfesttoulouse.fr

# --- SMTP — emails ---
# Local: SMTP_HOST=mailhog and SMTP_PORT=1025 (set by docker-compose.dev.yml)
# Prod:  SMTP_HOST=postfix and SMTP_PORT=25 (Coolify standalone Postfix)
# These two are usually NOT set in .env (compose imposes them per environment)
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_AUTH=false
# SMTP_USER=smtp-username           # only when SMTP_AUTH=true
# SMTP_PASSWORD=smtp-password       # only when SMTP_AUTH=true
SMTP_FROM=contact@devfesttoulouse.fr
# Logo shown in the email layout header (#269). Defaults to
# ${BASE_URL}/images/logo-devfest-96.png — override only if the logo must be
# served from elsewhere (a CDN reachable from mailboxes). PNG, not SVG:
# Gmail and Outlook don't render SVG.
# EMAIL_LOGO_URL=https://devfesttoulouse.fr/images/logo-devfest-96.png

# --- Third-party APIs ---
# Billetweb — manual import works without these
# BILLETWEB_USER=contact@devfesttoulouse.fr
# BILLETWEB_KEY=your-billetweb-api-key

# --- AI Translation (Google Gemini) ---
# Used by the back-office FR<->EN translator (POST /api/admin/translate).
# Without this key, the endpoint returns 503 not_configured and the UI
# button is disabled. Free tier note: data may be used for model training,
# do not enable on confidential content. Get a key:
# https://aistudio.google.com/apikey
# GEMINI_API_KEY=your-gemini-api-key

# --- Analytics (frontend, optional) ---
# URL of the Plausible script. If set, Plausible tracking is activated.
# Core Web Vitals (LCP, INP, CLS) are reported to Plausible as custom events
# when this is set — see src/frontend/src/components/WebVitals.tsx.
# NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.example.com/js/pa-XXXXX.js

# --- Monitoring (backend, optional) ---
# Webhook POSTed on every 5xx (Slack, n8n, Discord…). The same URL can also be
# set from the admin (Paramètres → Monitoring), but that one is read from the
# database: set the env var so a *database* outage still raises an alert.
# A repeated error is only notified once per 5-minute window.
# ALERT_WEBHOOK_URL=https://hooks.example.com/devfest-alerts
