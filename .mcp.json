{
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "--prefer-offline",
        "chrome-devtools-mcp@1.10.1",
        "--isolated",
        "--viewport=1280x860"
      ]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "--prefer-offline",
        "@playwright/mcp@0.0.83",
        "--browser=chrome",
        "--isolated",
        "--viewport-size=1280x860"
      ]
    }
  }
}
