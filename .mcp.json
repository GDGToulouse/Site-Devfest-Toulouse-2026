{
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "--prefer-offline",
        "chrome-devtools-mcp@1.10.1",
        "--isolated",
        "--viewport=1280x860"
      ]
    },
    "playwright-chrome": {
      "command": "npx",
      "args": [
        "-y",
        "--prefer-offline",
        "@playwright/mcp@0.0.83",
        "--browser=chrome",
        "--isolated",
        "--viewport-size=1280x860"
      ]
    },
    "playwright-firefox": {
      "command": "npx",
      "args": [
        "-y",
        "--prefer-offline",
        "@playwright/mcp@0.0.83",
        "--browser=firefox",
        "--isolated",
        "--viewport-size=1280x860"
      ]
    },
    "playwright-webkit": {
      "command": "npx",
      "args": [
        "-y",
        "--prefer-offline",
        "@playwright/mcp@0.0.83",
        "--browser=webkit",
        "--isolated",
        "--viewport-size=1280x860"
      ]
    },
    "devfest-prod": {
      "type": "http",
      "url": "https://devfesttoulouse.fr/api/mcp"
    },
    "devfest-beta": {
      "type": "http",
      "url": "https://beta.site.devfesttoulouse.fr/api/mcp"
    },
    "devfest-dev-j": {
      "type": "http",
      "url": "https://dev-j.site.devfesttoulouse.fr/api/mcp"
    }
  }
}